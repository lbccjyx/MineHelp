# Diagnostic history: logs are 1-2 MB each and were 15x the size of the source.
HookAlerter/_dev/*.log
HookAlerter/_dev/*.retired
HookAlerter/_dev/single_ref.cs
HookAlerter/_dev/single_ref.exe
HookAlerter/_dev/bounds.csv

# The pre-split single file (173 KB) duplicates source that is now in 10 shards.
HookAlerter/_dev/*.bak

# Strings dumped out of the game's SWF - game-derived content, not our work.
HookAlerter/_dev/*_strings.txt

# Large reference screenshots used only for --analyze smoke tests.
HookAlerter/_dev/ref/*.png

# Transient review artifact generated by the workflow; regenerate with git diff.
HookAlerter/_dev/*.diff

# F9 diagnostic frames: 360KB each, regenerate with F9.
HookAlerter/debug_*.png

# Archived run logs: live evidence kept out of git (each 100KB-1MB).
HookAlerter/_dev/archive/
